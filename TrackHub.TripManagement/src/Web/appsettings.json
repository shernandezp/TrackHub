{
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;user id=postgres;password=super;database=TrackHub;port=5432",
    "Logging": "server=localhost;user id=postgres;password=super;database=TrackHubLogs;port=5432"
  },
  "Serilog": {
    "Using": [
      "Common.Infrastructure"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "TrackHubPostgreSQL",
        "Args": {
          "connectionString": "Logging",
          "batchSizeLimit": 50,
          "period": "00:00:02"
        }
      }
    ]
  },
  "AuthorityServer": {
    "Authority": "https://trackhub.local:8443/Identity",
    "ValidateAudience": true,
    "ValidAudience": "trackhub_api",
    "ValidateIssuer": true,
    "ValidateIssuerSigningKey": true,
    "ClientId": "trip_client",
    "ClientSecret": "96cd18c9-d1b6-424b-9e29-b17842046d01",
    "Scope": "service_scope"
  },
  "AppSettings": {
    "GraphQLIdentityService": "https://trackhub.local:8443/Security/graphql/",
    "GraphQLManagerService": "https://trackhub.local:8443/Manager/graphql/",
    "GraphQLTelemetryService": "https://trackhub.local:8443/Telemetry/graphql/",
    "Routing": {
      "Provider": "OpenRouteService",
      "BaseUrl": "https://api.openrouteservice.org",
      "ApiKey": "",
      "Profile": "driving-hgv",
      "RequestsPerSecond": 2,
      "TimeoutSeconds": 20,
      "MaxWaypoints": 50,
      // Interactive route planning and background ETA refresh queue separately against the
      // provider's single rate limit; the background lane yields to interactive traffic and
      // spends at most BackgroundRequestsPerWindow requests per rolling window.
      "InteractiveTimeoutSeconds": 15,
      "BackgroundRequestsPerWindow": 250,
      "BackgroundWindowSeconds": 300
    }
  },
  "OpenIddict": {
    "LoadCertFromFile": true,
    "Path": "C:\\Certificates\\certificate.pfx",
    "Password": "openiddict",
    "Thumbprint": "33c9717a58f5f1c56f52d6de066098d5010dd673"
  },
  "AllowedHosts": "*",
  "AllowedCorsOrigins": "https://localhost:3000"
}
