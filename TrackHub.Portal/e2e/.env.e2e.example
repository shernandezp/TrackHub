# ---------------------------------------------------------------------------
# End-to-end suite configuration. Copy to e2e/.env.e2e (gitignored) and edit.
# Every value here is OPTIONAL: the defaults drive the seeded local stack.
# Backend URLs are NOT here — they are read from the portal's own .env/.env.local.
# ---------------------------------------------------------------------------

# Portal origin under test. Defaults to the origin of REACT_APP_CALLBACK_ENDPOINT.
# E2E_BASE_URL=https://localhost:3000

# Seeded administrator (Security DBInitializer). Roles: Administrator + Manager.
# E2E_ADMIN_EMAIL=email@mail.com
# E2E_ADMIN_PASSWORD=12345678

# Manager / plain User principals, for the role-gate tests.
#
# When these are absent the setup project CREATES the two users through the real
# Account Management screens and the global teardown deletes them again — but a
# user created that way can never SIGN IN, because nothing in the platform ever
# writes `security.users.verified` (the seeded administrator's row was set by
# hand). Point these at existing, verified accounts to run the role-gate tests.
# E2E_MANAGER_EMAIL=
# E2E_MANAGER_PASSWORD=
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=

# --- opt-in tests (each one skips loudly when its variable is absent) --------

# Reuse an already-running `npm start` instead of letting Playwright launch one.
# E2E_REUSE_SERVER=1

# The stack has live GPS positions, so map markers and playback can be asserted.
# E2E_HAS_POSITIONS=1

# Run the account-lifecycle and feature-gate tests against a DEDICATED account
# (created and archived by the suite) instead of skipping them. Without this the
# master account is never suspended.
# E2E_CREATE_ACCOUNT=1

# The document scanner runs, so a clean final state can be asserted.
# E2E_SCANNER=1

# A real GPS operator to run a manual synchronisation against.
# E2E_GPS_OPERATOR_ID=

# An in-transit trip for the exception verbs (pause/resume/force complete/abort).
# E2E_TRIP_IN_TRANSIT_ID=

# Allow switching the ACTIVE geocoding provider (affects every account).
# E2E_ALLOW_GEOCODING_SWITCH=1

# Allow the role permission matrix write (grant + revoke on a seeded role).
# The policy matrix is exercised unconditionally: policies are additive grants,
# so a failed revoke cannot break the mandatory baseline.
# E2E_ALLOW_ROLE_MATRIX_WRITE=1

# Allow changing the administrator's own password (and changing it back).
# ONE-WAY DOOR unless E2E_ADMIN_PASSWORD itself meets the platform policy
# (8+ characters, upper, lower, digit): the Security validator refuses to set a
# weaker one back, and the seeded 12345678 is weaker. The test skips otherwise.
# E2E_ALLOW_PASSWORD_CHANGE=1

# Sweep this run's own e2e-* rows in the global teardown too, not just older ones.
# E2E_SWEEP_ALL=1
