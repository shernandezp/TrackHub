# TrackHub Router API (GraphQL)
# Multi-stage build for .NET 10

# Stage 1: Build
# TrackHubCommon is a ProjectReference now (not a packed NuGet feed), so it must
# be present in the same layout as the repository and restores resolve it directly.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Central build configuration, shared by every project.
COPY global.json Directory.Build.props Directory.Packages.props ./

# Project files first: this layer only changes when a dependency changes,
# so the restore below stays cached across ordinary source edits.
COPY TrackHubCommon/Directory.Build.props TrackHubCommon/
COPY TrackHubCommon/src/Common.Application/Common.Application.csproj TrackHubCommon/src/Common.Application/
COPY TrackHubCommon/src/Common.Domain/Common.Domain.csproj TrackHubCommon/src/Common.Domain/
COPY TrackHubCommon/src/Common.Infrastructure/Common.Infrastructure.csproj TrackHubCommon/src/Common.Infrastructure/
COPY TrackHubCommon/src/Common.Web/Common.Web.csproj TrackHubCommon/src/Common.Web/
COPY TrackHubCommon/tests/Common.Application.Tests/Common.Application.Tests.csproj TrackHubCommon/tests/Common.Application.Tests/
COPY TrackHubCommon/tests/Common.Domain.Tests/Common.Domain.Tests.csproj TrackHubCommon/tests/Common.Domain.Tests/
COPY TrackHubCommon/tests/Common.Infrastructure.Tests/Common.Infrastructure.Tests.csproj TrackHubCommon/tests/Common.Infrastructure.Tests/
COPY TrackHubCommon/tests/Common.Web.Tests/Common.Web.Tests.csproj TrackHubCommon/tests/Common.Web.Tests/
COPY TrackHubRouter/src/Application/Application.csproj TrackHubRouter/src/Application/
COPY TrackHubRouter/src/Domain/Domain.csproj TrackHubRouter/src/Domain/
COPY TrackHubRouter/src/Infrastructure/CommandTrack/CommandTrack.csproj TrackHubRouter/src/Infrastructure/CommandTrack/
COPY TrackHubRouter/src/Infrastructure/Common/Common.csproj TrackHubRouter/src/Infrastructure/Common/
COPY TrackHubRouter/src/Infrastructure/Flespi/Flespi.csproj TrackHubRouter/src/Infrastructure/Flespi/
COPY TrackHubRouter/src/Infrastructure/GeofenceApi/GeofenceApi.csproj TrackHubRouter/src/Infrastructure/GeofenceApi/
COPY TrackHubRouter/src/Infrastructure/Geotab/Geotab.csproj TrackHubRouter/src/Infrastructure/Geotab/
COPY TrackHubRouter/src/Infrastructure/GpsGate/GpsGate.csproj TrackHubRouter/src/Infrastructure/GpsGate/
COPY TrackHubRouter/src/Infrastructure/ManagerApi/ManagerApi.csproj TrackHubRouter/src/Infrastructure/ManagerApi/
COPY TrackHubRouter/src/Infrastructure/Navixy/Navixy.csproj TrackHubRouter/src/Infrastructure/Navixy/
COPY TrackHubRouter/src/Infrastructure/Protrack/Protrack.csproj TrackHubRouter/src/Infrastructure/Protrack/
COPY TrackHubRouter/src/Infrastructure/Samsara/Samsara.csproj TrackHubRouter/src/Infrastructure/Samsara/
COPY TrackHubRouter/src/Infrastructure/TelemetryApi/TelemetryApi.csproj TrackHubRouter/src/Infrastructure/TelemetryApi/
COPY TrackHubRouter/src/Infrastructure/Traccar/Traccar.csproj TrackHubRouter/src/Infrastructure/Traccar/
COPY TrackHubRouter/src/Infrastructure/TripApi/TripApi.csproj TrackHubRouter/src/Infrastructure/TripApi/
COPY TrackHubRouter/src/Infrastructure/Wialon/Wialon.csproj TrackHubRouter/src/Infrastructure/Wialon/
COPY TrackHubRouter/src/SyncWorker/SyncWorker.csproj TrackHubRouter/src/SyncWorker/
COPY TrackHubRouter/src/Web/Web.csproj TrackHubRouter/src/Web/
COPY TrackHubRouter/tests/Application.UnitTests/Application.UnitTests.csproj TrackHubRouter/tests/Application.UnitTests/
COPY TrackHubRouter/tests/Intfrastructure.UnitTests/Infrastructure.UnitTests.csproj TrackHubRouter/tests/Intfrastructure.UnitTests/
COPY TrackHubRouter/tests/Web.UnitTests/Web.UnitTests.csproj TrackHubRouter/tests/Web.UnitTests/

RUN dotnet restore TrackHubRouter/src/Web/Web.csproj

# Then the sources.
COPY TrackHubCommon/ TrackHubCommon/
COPY TrackHubRouter/ TrackHubRouter/

RUN dotnet publish TrackHubRouter/src/Web/Web.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create certificates directory
RUN mkdir -p /app/certificates

# Copy published application
COPY --from=build /app/publish .

# Set environment variables
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:8080

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Entry point
ENTRYPOINT ["dotnet", "TrackHub.Router.Web.dll"]
