# TrackHub Manager API (GraphQL)
# Multi-stage build for .NET 10

# Stage 1: Build
# TrackHubCommon is a ProjectReference now (not a packed NuGet feed), so it must
# be present in the same layout as the repository and restores resolve it directly.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Central build configuration, shared by every project.
COPY global.json Directory.Build.props Directory.Packages.props ./

# Project files first: this layer only changes when a dependency changes,
# so the restore below stays cached across ordinary source edits.
COPY TrackHubCommon/Directory.Build.props TrackHubCommon/
COPY TrackHubCommon/src/Common.Application/Common.Application.csproj TrackHubCommon/src/Common.Application/
COPY TrackHubCommon/src/Common.Domain/Common.Domain.csproj TrackHubCommon/src/Common.Domain/
COPY TrackHubCommon/src/Common.Infrastructure/Common.Infrastructure.csproj TrackHubCommon/src/Common.Infrastructure/
COPY TrackHubCommon/src/Common.Web/Common.Web.csproj TrackHubCommon/src/Common.Web/
COPY TrackHubCommon/tests/Common.Application.Tests/Common.Application.Tests.csproj TrackHubCommon/tests/Common.Application.Tests/
COPY TrackHubCommon/tests/Common.Domain.Tests/Common.Domain.Tests.csproj TrackHubCommon/tests/Common.Domain.Tests/
COPY TrackHubCommon/tests/Common.Infrastructure.Tests/Common.Infrastructure.Tests.csproj TrackHubCommon/tests/Common.Infrastructure.Tests/
COPY TrackHubCommon/tests/Common.Web.Tests/Common.Web.Tests.csproj TrackHubCommon/tests/Common.Web.Tests/
COPY TrackHub.Manager/src/Application/Application.csproj TrackHub.Manager/src/Application/
COPY TrackHub.Manager/src/DBInitializer/DBInitializer.csproj TrackHub.Manager/src/DBInitializer/
COPY TrackHub.Manager/src/Domain/Domain.csproj TrackHub.Manager/src/Domain/
COPY TrackHub.Manager/src/Infrastructure/ManagerDB/ManagerDB.csproj TrackHub.Manager/src/Infrastructure/ManagerDB/
COPY TrackHub.Manager/src/Infrastructure/RouterApi/RouterApi.csproj TrackHub.Manager/src/Infrastructure/RouterApi/
COPY TrackHub.Manager/src/Infrastructure/SecurityApi/SecurityApi.csproj TrackHub.Manager/src/Infrastructure/SecurityApi/
COPY TrackHub.Manager/src/Web/Web.csproj TrackHub.Manager/src/Web/
COPY TrackHub.Manager/tests/Application.UnitTests/Application.UnitTests.csproj TrackHub.Manager/tests/Application.UnitTests/
COPY TrackHub.Manager/tests/Infrastructure.UnitTests/Infrastructure.UnitTests.csproj TrackHub.Manager/tests/Infrastructure.UnitTests/
COPY TrackHub.Manager/tests/Web.UnitTests/Web.UnitTests.csproj TrackHub.Manager/tests/Web.UnitTests/

RUN dotnet restore TrackHub.Manager/src/Web/Web.csproj

# Then the sources.
COPY TrackHubCommon/ TrackHubCommon/
COPY TrackHub.Manager/ TrackHub.Manager/

RUN dotnet publish TrackHub.Manager/src/Web/Web.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create certificates directory
RUN mkdir -p /app/certificates

# Copy published application
COPY --from=build /app/publish .

# Set environment variables
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:8080

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Entry point
ENTRYPOINT ["dotnet", "TrackHub.Manager.Web.dll"]
