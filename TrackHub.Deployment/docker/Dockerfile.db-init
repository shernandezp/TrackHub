# Database Initialization Container
# Runs ClientSeeder and DBInitializers once during initial deployment

# Stage 1: Build all three database initializers
# TrackHubCommon is a ProjectReference now, so every service is copied under its
# real repository path and restores resolve it directly — no packed feed.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY global.json Directory.Build.props Directory.Packages.props ./
COPY TrackHubCommon/ TrackHubCommon/
COPY TrackHub.AuthorityServer/ TrackHub.AuthorityServer/
COPY TrackHubSecurity/ TrackHubSecurity/
COPY TrackHub.Manager/ TrackHub.Manager/

RUN dotnet publish TrackHub.AuthorityServer/src/ClientSeeder/ClientSeeder.csproj -c Release -o /app/client-seeder
RUN dotnet publish TrackHubSecurity/src/DBInitializer/DBInitializer.csproj      -c Release -o /app/security-init
RUN dotnet publish TrackHub.Manager/src/DBInitializer/DBInitializer.csproj      -c Release -o /app/manager-init

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Install PostgreSQL client for connectivity checks
RUN apt-get update && apt-get install -y postgresql-client && rm -rf /var/lib/apt/lists/*

# Copy published applications
COPY --from=build /app/client-seeder ./client-seeder/
COPY --from=build /app/security-init ./security-init/
COPY --from=build /app/manager-init ./manager-init/

# Copy initialization scripts
COPY TrackHub.Deployment/scripts/init-databases.sh ./init-databases.sh
COPY TrackHub.Deployment/scripts/sync-user-account-ids.sh ./sync-user-account-ids.sh
RUN chmod +x ./init-databases.sh ./sync-user-account-ids.sh

# Create flags directory for tracking initialization state
RUN mkdir -p /app/flags

ENTRYPOINT ["./init-databases.sh"]
