# TrackHub Trip Management API (GraphQL)
# Multi-stage build for .NET 10

# Stage 1: Build
# TrackHubCommon is a ProjectReference now (not a packed NuGet feed), so it must
# be present in the same layout as the repository and restores resolve it directly.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Central build configuration, shared by every project.
COPY global.json Directory.Packages.props ./

# Project files first: this layer only changes when a dependency changes,
# so the restore below stays cached across ordinary source edits.
COPY TrackHubCommon/Directory.Build.props TrackHubCommon/
COPY TrackHubCommon/src/Common.Application/Common.Application.csproj TrackHubCommon/src/Common.Application/
COPY TrackHubCommon/src/Common.Domain/Common.Domain.csproj TrackHubCommon/src/Common.Domain/
COPY TrackHubCommon/src/Common.Infrastructure/Common.Infrastructure.csproj TrackHubCommon/src/Common.Infrastructure/
COPY TrackHubCommon/src/Common.Web/Common.Web.csproj TrackHubCommon/src/Common.Web/
COPY TrackHubCommon/tests/Common.Application.Tests/Common.Application.Tests.csproj TrackHubCommon/tests/Common.Application.Tests/
COPY TrackHubCommon/tests/Common.Domain.Tests/Common.Domain.Tests.csproj TrackHubCommon/tests/Common.Domain.Tests/
COPY TrackHubCommon/tests/Common.Infrastructure.Tests/Common.Infrastructure.Tests.csproj TrackHubCommon/tests/Common.Infrastructure.Tests/
COPY TrackHubCommon/tests/Common.Web.Tests/Common.Web.Tests.csproj TrackHubCommon/tests/Common.Web.Tests/
COPY TrackHub.TripManagement/Directory.Build.props TrackHub.TripManagement/
COPY TrackHub.TripManagement/src/Application/Application.csproj TrackHub.TripManagement/src/Application/
COPY TrackHub.TripManagement/src/Domain/Domain.csproj TrackHub.TripManagement/src/Domain/
COPY TrackHub.TripManagement/src/Infrastructure/ManagerApi/ManagerApi.csproj TrackHub.TripManagement/src/Infrastructure/ManagerApi/
COPY TrackHub.TripManagement/src/Infrastructure/RoutingApi/RoutingApi.csproj TrackHub.TripManagement/src/Infrastructure/RoutingApi/
COPY TrackHub.TripManagement/src/Infrastructure/TelemetryApi/TelemetryApi.csproj TrackHub.TripManagement/src/Infrastructure/TelemetryApi/
COPY TrackHub.TripManagement/src/Infrastructure/TripDB/TripDB.csproj TrackHub.TripManagement/src/Infrastructure/TripDB/
COPY TrackHub.TripManagement/src/Web/Web.csproj TrackHub.TripManagement/src/Web/
COPY TrackHub.TripManagement/tests/Application.UnitTests/Application.UnitTests.csproj TrackHub.TripManagement/tests/Application.UnitTests/
COPY TrackHub.TripManagement/tests/Infrastructure.UnitTests/Infrastructure.UnitTests.csproj TrackHub.TripManagement/tests/Infrastructure.UnitTests/
COPY TrackHub.TripManagement/tests/Web.UnitTests/Web.UnitTests.csproj TrackHub.TripManagement/tests/Web.UnitTests/

RUN dotnet restore TrackHub.TripManagement/src/Web/Web.csproj

# Then the sources.
COPY TrackHubCommon/ TrackHubCommon/
COPY TrackHub.TripManagement/ TrackHub.TripManagement/

RUN dotnet publish TrackHub.TripManagement/src/Web/Web.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create certificates directory
RUN mkdir -p /app/certificates

# Copy published application
COPY --from=build /app/publish .

# Set environment variables
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:8080

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Entry point
ENTRYPOINT ["dotnet", "TrackHub.TripManagement.Web.dll"]
