{
  "_comment": "Master configuration template for all TrackHub services",
  "_usage": "Run ./scripts/generate-appsettings.sh to generate service-specific appsettings.json files",
  
  "common": {
    "_Serilog_comment": "The PostgreSQL sink carries restrictedToMinimumLevel=Warning so production stops flooding the logs table with Information. Console keeps MinimumLevel (Information). Kept in sync with serilog_section() in scripts/generate-appsettings.sh.",
    "Serilog": {
      "Using": [
        "Common.Infrastructure"
      ],
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Warning",
          "Microsoft.AspNetCore": "Warning",
          "Microsoft.Hosting.Lifetime": "Information",
          "OpenIddict": "Warning",
          "System": "Warning"
        }
      },
      "WriteTo": [
        { "Name": "Console" },
        {
          "Name": "TrackHubPostgreSQL",
          "Args": {
            "restrictedToMinimumLevel": "Warning",
            "connectionString": "Logging",
            "batchSizeLimit": 50,
            "period": "00:00:02"
          }
        }
      ]
    },
    "AllowedHosts": "*",
    "AllowedCorsOrigins": "${ALLOWED_CORS_ORIGINS}",
    "AuthorityServer": {
      "Authority": "${AUTHORITY_URL}",
      "ValidateAudience": true,
      "ValidAudience": "trackhub_api",
      "ValidateIssuer": true,
      "ValidateIssuerSigningKey": true
    },
    "OpenIddict": {
      "LoadCertFromFile": true,
      "Path": "${CERTIFICATE_PATH}",
      "Password": "${CERTIFICATE_PASSWORD}",
      "Thumbprint": "${CERTIFICATE_THUMBPRINT}"
    }
  },

  "services": {
    "authority": {
      "ConnectionStrings": {
        "Security": "${DB_CONNECTION_SECURITY}",
        "Logging": "${DB_CONNECTION_LOGGING}"
      },
      "OpenIddict": {
        "LoadCertFromFile": true,
        "Path": "${CERTIFICATE_PATH}",
        "Password": "${CERTIFICATE_PASSWORD}",
        "Thumbprint": "${CERTIFICATE_THUMBPRINT}",
        "Scopes": "${OPENIDDICT_SCOPES}"
      }
    },

    "security": {
      "ConnectionStrings": {
        "Security": "${DB_CONNECTION_SECURITY}",
        "Logging": "${DB_CONNECTION_LOGGING}"
      },
      "AuthorityServer": {
        "ClientId": "${SECURITY_CLIENT_ID}",
        "ClientSecret": "${SECURITY_CLIENT_SECRET}",
        "Scope": "service_scope"
      },
      "AppSettings": {
        "GraphQLManagerService": "${GRAPHQL_MANAGER_SERVICE}",
        "EncryptionKey": "${ENCRYPTION_KEY}"
      }
    },

    "manager": {
      "ConnectionStrings": {
        "DefaultConnection": "${DB_CONNECTION_MANAGER}",
        "Logging": "${DB_CONNECTION_LOGGING}"
      },
      "_AppSettings_comment": "Smtp/WhatsApp power the spec-05 notification channels. Empty Smtp.Host or WhatsApp.PhoneNumberId/AccessToken disables that channel's sends (deliveries fail with a clear provider error).",
      "AppSettings": {
        "GraphQLIdentityService": "${GRAPHQL_IDENTITY_SERVICE}",
        "GraphQLSecurityService": "${GRAPHQL_SECURITY_SERVICE}",
        "GraphQLRouterService": "${GRAPHQL_ROUTER_SERVICE}",
        "EncryptionKey": "${ENCRYPTION_KEY}",
        "PortalBaseUrl": "${PORTAL_BASE_URL}",
        "NotificationSendingReclaimMinutes": "${NOTIFICATION_SENDING_RECLAIM_MINUTES}",
        "Smtp": {
          "Host": "${SMTP_HOST}",
          "Port": "${SMTP_PORT}",
          "Username": "${SMTP_USERNAME}",
          "Password": "${SMTP_PASSWORD}",
          "UseStartTls": "${SMTP_USE_STARTTLS}",
          "FromAddress": "${SMTP_FROM_ADDRESS}",
          "FromName": "${SMTP_FROM_NAME}"
        },
        "WhatsApp": {
          "ApiBaseUrl": "${WHATSAPP_API_BASE_URL}",
          "PhoneNumberId": "${WHATSAPP_PHONE_NUMBER_ID}",
          "AccessToken": "${WHATSAPP_ACCESS_TOKEN}",
          "TemplateName": "${WHATSAPP_TEMPLATE_NAME}"
        }
      },
      "_DocumentStorage_comment": "Provider = LocalFileSystem (default) | S3 | AzureBlob. LocalFileSystem uses LocalRootPath only. S3 REQUIRES S3.BucketName and AzureBlob REQUIRES AzureBlob.ContainerName + AzureBlob.ConnectionString - the Manager throws at startup when they are missing. Populate them via the DOCUMENT_S3_* / DOCUMENT_AZURE_* variables in .env (see .env.example).",
      "DocumentStorage": {
        "Provider": "${DOCUMENT_STORAGE_PROVIDER}",
        "LocalRootPath": "${DOCUMENT_STORAGE_LOCAL_ROOT}",
        "RetentionDays": "${DOCUMENT_RETENTION_DAYS}",
        "S3": {
          "BucketName": "${DOCUMENT_S3_BUCKET_NAME}",
          "Region": "${DOCUMENT_S3_REGION}",
          "ServiceUrl": "${DOCUMENT_S3_SERVICE_URL}",
          "ForcePathStyle": "${DOCUMENT_S3_FORCE_PATH_STYLE}",
          "AccessKey": "${DOCUMENT_S3_ACCESS_KEY}",
          "SecretKey": "${DOCUMENT_S3_SECRET_KEY}",
          "PresignedExpiryMinutes": "${DOCUMENT_S3_PRESIGNED_EXPIRY_MINUTES}"
        },
        "AzureBlob": {
          "ConnectionString": "${DOCUMENT_AZURE_CONNECTION_STRING}",
          "ContainerName": "${DOCUMENT_AZURE_CONTAINER_NAME}",
          "SasExpiryMinutes": "${DOCUMENT_AZURE_SAS_EXPIRY_MINUTES}"
        }
      }
    },

    "router": {
      "ConnectionStrings": {
        "Logging": "${DB_CONNECTION_LOGGING}"
      },
      "AuthorityServer": {
        "ClientId": "${ROUTER_CLIENT_ID}",
        "ClientSecret": "${ROUTER_CLIENT_SECRET}",
        "Scope": "service_scope"
      },
      "AppSettings": {
        "GraphQLIdentityService": "${GRAPHQL_IDENTITY_SERVICE}",
        "GraphQLManagerService": "${GRAPHQL_MANAGER_SERVICE}",
        "GraphQLGeofenceService": "${GRAPHQL_GEOFENCE_SERVICE}",
        "GraphQLTelemetryService": "${GRAPHQL_TELEMETRY_SERVICE}",
        "GraphQLTripManagementService": "${GRAPHQL_TRIP_SERVICE}",
        "EncryptionKey": "${ENCRYPTION_KEY}",
        "Protocols": ["CommandTrack", "Flespi", "GeoTab", "GpsGate", "Navixy", "Protrack", "Samsara", "Traccar", "Wialon"]
      }
    },

    "syncworker": {
      "_comment": "Background worker (device sync, health checks, position sync). client_credentials only - it has no inbound API, hence IsService=true + Scope=service_scope. Protocols MUST stay in sync with the router list above.",
      "ConnectionStrings": {
        "Logging": "${DB_CONNECTION_LOGGING}"
      },
      "AuthorityServer": {
        "ClientId": "${SYNCWORKER_CLIENT_ID}",
        "ClientSecret": "${SYNCWORKER_CLIENT_SECRET}",
        "Scope": "service_scope"
      },
      "AppSettings": {
        "GraphQLIdentityService": "${GRAPHQL_IDENTITY_SERVICE}",
        "GraphQLManagerService": "${GRAPHQL_MANAGER_SERVICE}",
        "GraphQLTelemetryService": "${GRAPHQL_TELEMETRY_SERVICE}",
        "GraphQLGeofenceService": "${GRAPHQL_GEOFENCE_SERVICE}",
        "GraphQLTripManagementService": "${GRAPHQL_TRIP_SERVICE}",
        "EncryptionKey": "${ENCRYPTION_KEY}",
        "Protocols": ["CommandTrack", "Flespi", "GeoTab", "GpsGate", "Navixy", "Protrack", "Samsara", "Traccar", "Wialon"]
      }
    },

    "geofencing": {
      "ConnectionStrings": {
        "DefaultConnection": "${DB_CONNECTION_MANAGER}",
        "Logging": "${DB_CONNECTION_LOGGING}"
      },
      "AuthorityServer": {
        "ClientId": "${GEOFENCE_CLIENT_ID}",
        "ClientSecret": "${GEOFENCE_CLIENT_SECRET}",
        "Scope": "service_scope"
      },
      "AppSettings": {
        "GraphQLIdentityService": "${GRAPHQL_IDENTITY_SERVICE}",
        "GraphQLManagerService": "${GRAPHQL_MANAGER_SERVICE}"
      }
    },

    "tripmanagement": {
      "_comment": "The `trip` schema lives in the same TrackHub database as Manager/Geofencing and needs the same postgis extension.",
      "ConnectionStrings": {
        "DefaultConnection": "${DB_CONNECTION_MANAGER}",
        "Logging": "${DB_CONNECTION_LOGGING}"
      },
      "AuthorityServer": {
        "ClientId": "${TRIP_CLIENT_ID}",
        "ClientSecret": "${TRIP_CLIENT_SECRET}",
        "Scope": "service_scope"
      },
      "_Routing_comment": "OpenRouteService directions/matrix. REQUIRED per deployment (spec 11 §14): an empty ApiKey degrades route planning to RoutePlan.Failed + ROUTING_NOT_CONFIGURED - trips stay usable but no route is ever produced. Point BaseUrl at a self-hosted ORS instance to avoid the public quota. Note this key is deliberately configured TWICE on the platform: here for TripManagement's routing, and as a Manager GeocodingProvider row for Router's reverse geocoding (spec 11 §7.2/§18.7).",
      "AppSettings": {
        "GraphQLIdentityService": "${GRAPHQL_IDENTITY_SERVICE}",
        "GraphQLManagerService": "${GRAPHQL_MANAGER_SERVICE}",
        "GraphQLTelemetryService": "${GRAPHQL_TELEMETRY_SERVICE}",
        "Routing": {
          "Provider": "${ROUTING_PROVIDER}",
          "BaseUrl": "${ORS_BASE_URL}",
          "ApiKey": "${ORS_API_KEY}",
          "Profile": "${ORS_PROFILE}",
          "RequestsPerSecond": "${ORS_REQUESTS_PER_SECOND}",
          "TimeoutSeconds": "${ORS_TIMEOUT_SECONDS}",
          "MaxWaypoints": "${ORS_MAX_WAYPOINTS}",
          "InteractiveTimeoutSeconds": "${ORS_INTERACTIVE_TIMEOUT_SECONDS}",
          "BackgroundRequestsPerWindow": "${ORS_BACKGROUND_REQUESTS_PER_WINDOW}",
          "BackgroundWindowSeconds": "${ORS_BACKGROUND_WINDOW_SECONDS}"
        }
      }
    },

    "telemetry": {
      "ConnectionStrings": {
        "DefaultConnection": "${DB_CONNECTION_TELEMETRY}",
        "Logging": "${DB_CONNECTION_LOGGING}"
      },
      "AppSettings": {
        "GraphQLIdentityService": "${GRAPHQL_IDENTITY_SERVICE}"
      }
    },

    "reporting": {
      "ConnectionStrings": {
        "Logging": "${DB_CONNECTION_LOGGING}"
      },
      "AppSettings": {
        "GraphQLIdentityService": "${GRAPHQL_IDENTITY_SERVICE}",
        "GraphQLRouterService": "${GRAPHQL_ROUTER_SERVICE}",
        "GraphQLGeofenceService": "${GRAPHQL_GEOFENCE_SERVICE}",
        "GraphQLManagerService": "${GRAPHQL_MANAGER_SERVICE}",
        "GraphQLTelemetryService": "${GRAPHQL_TELEMETRY_SERVICE}",
        "GraphQLTripManagementService": "${GRAPHQL_TRIP_SERVICE}",
        "Reporting": {
          "MaxExportRows": "${REPORTING_MAX_EXPORT_ROWS}",
          "MaxPdfRows": "${REPORTING_MAX_PDF_ROWS}",
          "PreviewRows": "${REPORTING_PREVIEW_ROWS}"
        }
      }
    }
  }
}
