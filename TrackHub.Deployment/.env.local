# =============================================================================
# TrackHub - LOCAL Docker Desktop (Windows) environment
# =============================================================================
# Committed on purpose, exactly like appsettings.json: these are local development values,
# so a fresh clone runs with no setup. There is no template to fill in.
#
#   scripts/local/Start-TrackHubLocal.ps1   passes this file with --env-file
#
# The file is also sourced by scripts/generate-appsettings.sh, which runs under
# bash - so every value containing ";" or spaces MUST stay double-quoted.
# =============================================================================

# -----------------------------------------------------------------------------
# Entry point
# -----------------------------------------------------------------------------
# IIS owns localhost:443 on this machine, so the TrackHub proxy takes 8443.
#
# trackhub.local must resolve to 127.0.0.1 in C:\Windows\System32\drivers\etc\hosts
# AND to the Docker host gateway inside containers (docker-compose.local.yml does
# the second half with extra_hosts). It cannot be "localhost": AuthorityServer:Authority
# is simultaneously the JWT ValidIssuer, the OIDC discovery URL and the token endpoint
# used by GraphQLClientFactory, so the same string has to work in the browser and
# inside a container - and inside a container "localhost" is the container itself.
DOMAIN=trackhub.local
AUTHORITY_URL=https://trackhub.local:8443/Identity

# The portal runs on the Vite dev server, not in Docker.
# NOTE: exactly ONE origin is supported. Program.cs calls WithOrigins(allowedCORSOrigins)
# with a single string, so a comma-separated list would be read as one invalid origin.
ALLOWED_CORS_ORIGINS=https://localhost:3000
PORTAL_BASE_URL=https://localhost:3000

# -----------------------------------------------------------------------------
# Database - the native Postgres 14 service on the host, not a container.
# It is already reachable from Docker: postgresql.conf has listen_addresses = '*'
# and pg_hba.conf carries "host all all 172.16.0.0/12 scram-sha-256".
# -----------------------------------------------------------------------------
DB_CONNECTION_SECURITY="server=host.docker.internal;user id=postgres;password=super;database=TrackHubSecurity;port=5432"
DB_CONNECTION_MANAGER="server=host.docker.internal;user id=postgres;password=super;database=TrackHub;port=5432"
DB_CONNECTION_TELEMETRY="server=host.docker.internal;user id=postgres;password=super;database=TrackHub;port=5432"
DB_CONNECTION_LOGGING="server=host.docker.internal;user id=postgres;password=super;database=TrackHub;port=5432"

# -----------------------------------------------------------------------------
# Service-to-service GraphQL - container to container, over the Docker network.
# These never leave the bridge, so they stay plain HTTP on the internal port.
# -----------------------------------------------------------------------------
GRAPHQL_IDENTITY_SERVICE=http://security:8080/graphql/
GRAPHQL_SECURITY_SERVICE=http://security:8080/graphql/
GRAPHQL_MANAGER_SERVICE=http://manager:8080/graphql/
GRAPHQL_TELEMETRY_SERVICE=http://telemetry:8080/graphql/
GRAPHQL_ROUTER_SERVICE=http://router:8080/graphql/
GRAPHQL_GEOFENCE_SERVICE=http://geofencing:8080/graphql/
GRAPHQL_TRIP_SERVICE=http://tripmanagement:8080/graphql/

# -----------------------------------------------------------------------------
# OpenIddict signing certificate.
# Reuse the SAME certificate.pfx the IIS apps use, otherwise tokens minted by the
# containerised authority will not validate against anything else on this machine.
# Setup-TrackHubLocal.ps1 copies it into certificates/.
# -----------------------------------------------------------------------------
CERTIFICATE_PASSWORD=openiddict
CERTIFICATE_PATH=/app/certificates/certificate.pfx
CERTIFICATE_THUMBPRINT=33c9717a58f5f1c56f52d6de066098d5010dd673
OPENIDDICT_SCOPES=mobile_scope,driver_mobile_scope,web_scope,service_scope

# -----------------------------------------------------------------------------
# Service clients.
# These match the seeded local TrackHubSecurity database and the values in each service
# appsettings.json. db-init is disabled locally, so nothing re-seeds them - change one here
# only if you also re-seed the database.
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=4F2C2E66-107F-452A-ACDE-402DFD47B84C

SECURITY_CLIENT_ID=security_client
SECURITY_CLIENT_SECRET=6f3d1c4a-9b27-4e58-8a11-2c7f5d90ab34


ROUTER_CLIENT_ID=router_client
ROUTER_CLIENT_SECRET=0e22a8ea-0533-4b21-972f-6c7406842d98

GEOFENCE_CLIENT_ID=geofence_client
GEOFENCE_CLIENT_SECRET=8c5f1d9b-3e72-4a06-b1c8-64f0d2a97e35

TRIP_CLIENT_ID=trip_client
TRIP_CLIENT_SECRET=96cd18c9-d1b6-424b-9e29-b17842046d01


# Only needed with --profile workers. OpenIddict stores secrets hashed, so this
# cannot be recovered from the database - re-seed the client if you need it.
SYNCWORKER_CLIENT_ID=syncworker_client
SYNCWORKER_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Manager: document storage and notification channels.
# Empty channel credentials keep that channel disabled, which is what you want locally.
# -----------------------------------------------------------------------------
DOCUMENT_STORAGE_PROVIDER=LocalFileSystem
DOCUMENT_STORAGE_LOCAL_ROOT=/app/documents
DOCUMENT_RETENTION_DAYS=1825
DOCUMENT_S3_BUCKET_NAME=
DOCUMENT_S3_REGION=
DOCUMENT_S3_SERVICE_URL=
DOCUMENT_S3_ACCESS_KEY=
DOCUMENT_S3_SECRET_KEY=
DOCUMENT_S3_FORCE_PATH_STYLE=
DOCUMENT_S3_PRESIGNED_EXPIRY_MINUTES=
DOCUMENT_AZURE_CONNECTION_STRING=
DOCUMENT_AZURE_CONTAINER_NAME=
DOCUMENT_AZURE_SAS_EXPIRY_MINUTES=

NOTIFICATION_DELIVERY_RETENTION_DAYS=90
NOTIFICATION_SENDING_RECLAIM_MINUTES=10
BACKGROUND_JOB_RUN_RETENTION_DAYS=90
ALERT_EVENT_RETENTION_DAYS=180

SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=false
SMTP_FROM_ADDRESS=alerts@trackhub.local
SMTP_FROM_NAME="TrackHub Alerts"

WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=trackhub_alert


# -----------------------------------------------------------------------------
# TripManagement routing (OpenRouteService). Empty ORS_API_KEY disables routing.
# -----------------------------------------------------------------------------
ROUTING_PROVIDER=OpenRouteService
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=
ORS_PROFILE=driving-hgv
ORS_REQUESTS_PER_SECOND=2
ORS_TIMEOUT_SECONDS=20
ORS_MAX_WAYPOINTS=50
ORS_INTERACTIVE_TIMEOUT_SECONDS=15
ORS_BACKGROUND_REQUESTS_PER_WINDOW=250
ORS_BACKGROUND_WINDOW_SECONDS=300

# -----------------------------------------------------------------------------
# Reporting limits
# -----------------------------------------------------------------------------
REPORTING_MAX_EXPORT_ROWS=100000
REPORTING_MAX_PDF_ROWS=500
REPORTING_PREVIEW_ROWS=100
